---
import Base from "../layouts/Base.astro";
import IpodShape from "../components/IpodShape.astro";
import { href } from "../lib/catalog.js";
---
<Base title="Welcome" description="Set up your Quitanda account: tell us whether you use an iPod or make things for one, and choose whether to get the newsletter.">
  <main class="wrap page">
    <div class="welcome">
      <div class="welcome-main">
        <header class="intro">
          <p class="lcd-kicker" id="w-kicker">Welcome</p>
          <h1 id="w-title">Welcome to Quitanda</h1>
          <p id="w-lede">Tell us what you’re here for and we’ll point you to the right guide. You can change both answers later on your account page.</p>
        </header>

        <p id="w-loading" class="aside-note">Checking whether you’re signed in…</p>

        <section id="w-out" hidden>
          <p>Sign in with the button at the top of the page to set up your account. You don’t need one to browse or download.</p>
        </section>

        <form id="w-form" class="welcome-form" novalidate hidden>
          <fieldset class="role-choice">
            <legend>What brings you here?</legend>
            <div class="role-cards">
              <label class="role-card">
                <input type="radio" name="role" value="user" required />
                <IpodShape look="classic" />
                <span class="role-text">
                  <strong>I use an iPod</strong>
                  <span>I want firmware, apps and themes for my iPod, and help installing them.</span>
                </span>
              </label>
              <label class="role-card">
                <input type="radio" name="role" value="creator" />
                <span class="crate-draw" aria-hidden="true"><span class="box"><i></i><i></i><i></i></span><span class="f1"></span><span class="f2"></span></span>
                <span class="role-text">
                  <strong>I make things for iPods</strong>
                  <span>I build firmware, themes, apps or hardware mods, and want people to find them.</span>
                </span>
              </label>
            </div>
          </fieldset>

          <fieldset class="news-choice">
            <legend>News and updates</legend>
            <label class="theme-check">
              <input type="checkbox" id="w-news" />
              <span>Email me Quitanda news and updates.</span>
            </label>
            <p class="news-terms">Occasional emails about new firmware, themes and guides. We use your name and email address for this and nothing else, never share them, and you can unsubscribe at any time. <a href={href("/privacy/")}>Privacy policy</a></p>
            <div id="w-news-fields" hidden>
              <label class="news-field">
                <span>Name to greet you by</span>
                <input class="field" id="w-name" maxlength="80" autocomplete="name" />
              </label>
              <p class="news-address">Emails go to <strong id="w-email"></strong>, the address you signed in with.</p>
            </div>
            <p id="w-news-unavailable" class="aside-note" hidden>Your sign-in has no verified email address, so the newsletter isn’t available for this account.</p>
          </fieldset>

          <div class="acct-actions">
            <button type="submit" class="btn btn-lg" id="w-save">Continue</button>
            <span id="w-status" role="status"></span>
          </div>
          <p id="w-error" class="signin-error" role="alert" hidden></p>
        </form>

        <section id="w-done" class="welcome-done" hidden>
          <h2 id="w-done-title">You’re all set</h2>
          <p id="w-done-text"></p>
          <p><a class="btn btn-lg" id="w-guide" href={href("/start/ipod-users/")}>Open your guide →</a></p>
          <ul class="guide-links compact" id="w-next"></ul>
          <p class="aside-note">Change your choices any time on <a href={href("/account/")}>your account page</a>.</p>
        </section>
      </div>

      <aside class="guide-preview" aria-label="Your guide">
        <p class="lcd-kicker">Your guide, ready when you are</p>
        <div class="frame">
          <div class="lcd-menu" id="w-menu">
            <div><span id="w-menu-title">iPod owners</span><span aria-hidden="true">▮▮▮▯</span></div>
          </div>
        </div>
        <h2 id="w-guide-title">Give your iPod a second life</h2>
        <p id="w-guide-text">Seven steps, about an hour for the first install. Nothing in it needs you to open the iPod.</p>
        <p><a class="more-link" id="w-guide-link" href={href("/start/ipod-users/")}>Read it now →</a></p>
      </aside>
    </div>
  </main>
</Base>

<script>
  import { onUser } from "../scripts/account.js";
  import { h, link } from "../scripts/theme-ui.js";

  const $ = (id) => document.getElementById(id);
  const member = () => import("../lib/member.js");

  const NEXT = {
    user: {
      guide: "/start/ipod-users/",
      text: "Your guide walks through finding out which iPod you have, installing your first firmware, and loading music.",
      links: [
        ["/", "Browse firmware", "Choose your iPod and see what runs on it."],
        ["/themes/", "Find a theme", "Looks other people have made."],
        ["/mods/", "Hardware mods", "Flash storage, batteries, Bluetooth."],
      ],
    },
    creator: {
      guide: "/start/makers/",
      text: "Your guide covers getting your project listed, keeping its version current automatically, and sharing themes.",
      links: [
        ["/themes/submit/", "Share a theme", "Upload it with screenshots."],
        ["/about/#add-or-correct-a-listing", "Add or fix a listing", "Firmware, apps and mods."],
        ["/blog/", "Read the blog", "News from the shop."],
      ],
    },
  };

  // The preview beside the form: the chosen guide, drawn as an iPod menu.
  const PREVIEW = {
    user: {
      menu: "iPod owners", title: "Give your iPod a second life", path: "/start/ipod-users/",
      text: "Seven steps, about an hour for the first install. Nothing in it needs you to open the iPod.",
      rows: ["Find out which iPod you have", "Back up and prepare", "Install your first firmware", "Try another flavor", "Put music on it", "Make it yours", "If something goes wrong"],
    },
    creator: {
      menu: "Makers and modders", title: "Put your work on the shelves", path: "/start/makers/",
      text: "Listings are free, link straight to your own downloads, and stay under your control.",
      rows: ["Get your project listed", "Keep the version current", "Status and compatibility", "Screenshots", "Share themes", "Hardware mods", "It’s your listing"],
    },
  };
  function showPreview(role) {
    const g = PREVIEW[role] || PREVIEW.user;
    $("w-menu-title").textContent = g.menu;
    $("w-menu").replaceChildren($("w-menu").firstElementChild, ...g.rows.map((label) => h("div", {}, h("span", {}, label), h("span", { "aria-hidden": "true" }, "›"))));
    $("w-guide-title").textContent = g.title;
    $("w-guide-text").textContent = g.text;
    $("w-guide-link").href = link(g.path);
    $("w-save").textContent = role === "creator" ? "Continue as a maker" : role === "user" ? "Continue as an iPod owner" : "Continue";
  }
  showPreview();
  document.querySelectorAll('#w-form [name="role"]').forEach((radio) => radio.addEventListener("change", () => showPreview(radio.value)));

  function showDone(role, subscribed) {
    showPreview(role);
    const next = NEXT[role] || NEXT.user;
    $("w-form").hidden = true;
    $("w-lede").hidden = true;
    $("w-done-text").textContent = next.text + (subscribed ? " You’re on the newsletter list." : "");
    $("w-guide").href = link(next.guide);
    $("w-next").replaceChildren(...next.links.map(([path, title, text]) => h("li", {}, h("a", { href: link(path) }, h("strong", {}, title), h("span", {}, text)))));
    $("w-done").hidden = false;
  }

  let ready = false;
  onUser(async (user) => {
    $("w-loading").hidden = true;
    $("w-out").hidden = !!user;
    if (!user) {
      $("w-form").hidden = true;
      $("w-done").hidden = true;
      ready = false;
      return;
    }
    if (ready) return; // already showing this person's form or result
    ready = true;
    const { loadMember, loadSubscription, canSubscribe, myEmail } = await member();
    const [settings, subscription] = await Promise.all([loadMember(), loadSubscription().catch(() => null)]);
    const first = (user.displayName || "").split(" ")[0];
    if (first) $("w-title").textContent = `Welcome, ${first}.`;
    $("w-kicker").textContent = "You’re in · two quick choices";
    if (settings?.role) return showDone(settings.role, !!subscription);
    $("w-name").value = user.displayName || "";
    $("w-email").textContent = myEmail();
    $("w-news").disabled = !canSubscribe();
    $("w-news-unavailable").hidden = canSubscribe();
    $("w-form").hidden = false;
  });

  $("w-news").addEventListener("change", () => ($("w-news-fields").hidden = !$("w-news").checked));
  // A choice answers the "choose one" message, so clear it.
  $("w-form").addEventListener("change", () => ($("w-error").hidden = true));

  $("w-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const error = $("w-error");
    const fail = (message) => ((error.textContent = message), (error.hidden = false), ($("w-status").textContent = ""));
    error.hidden = true;
    const role = new FormData($("w-form")).get("role");
    if (!role) return fail("Choose one of the two options above.");
    const wantsNews = $("w-news").checked;
    if (wantsNews && !$("w-name").value.trim()) return fail("Enter the name to greet you by, or untick the newsletter.");
    $("w-save").disabled = true;
    $("w-status").textContent = "Saving…";
    try {
      const { saveMember, subscribe } = await member();
      await saveMember(role);
      if (wantsNews) await subscribe($("w-name").value);
      showDone(role, wantsNews);
      window.scrollTo({ top: 0 });
    } catch (err) {
      fail(err.code ? "Couldn’t save. Check your connection and try again." : err.message);
    } finally {
      $("w-save").disabled = false;
    }
  });
</script>
