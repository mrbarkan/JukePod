---
// One AdSense ad unit, labeled as an ad. Renders nothing until both the
// publisher ID and this slot's ID are set in src/lib/ads.js.
import { ADS, adsOn } from "../lib/ads.js";
const { slot } = Astro.props;
const id = ADS.slots[slot];
---
{adsOn && id && (
  <aside class="ad-slot" aria-label="Advertisement">
    <span class="ad-label">Ad</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADS.client}
      data-ad-slot={id}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
