---
import Base from "../layouts/Base.astro";
import IpodShape from "../components/IpodShape.astro";
import { href, devices } from "../lib/catalog.js";
import { followable } from "../lib/releases.js";
import { ALERTS_ON, EVERY_IPOD } from "../lib/alerts-config.js";
---
<Base title="Your account" description="Your Quitanda profile.">
  <main class="wrap page">
    <p id="acct-loading" class="aside-note">Checking whether you're signed in…</p>

    <section id="acct-out" hidden>
      <header class="intro">
        <h1>Your account</h1>
        <p>You're not signed in. Use <strong>Sign in</strong> at the top of the page.</p>
      </header>
    </section>

    <div id="acct-in" class="page" style="padding-block: 0" hidden>
      <p class="acct-admin" id="acct-admin" hidden>You're an admin of this site. <a id="acct-review" href={href("/themes/review/")}>Open the review queue</a></p>
      <p class="theme-notice" id="acct-welcome" hidden><span>You haven’t finished setting up.</span> <a href={href("/welcome/")}>Choose your guide and newsletter settings</a></p>

      <section class="profile-banner">
        <span class="avatar-sticker" aria-hidden="true"><span id="acct-initial"></span><img id="acct-photo" alt="" referrerpolicy="no-referrer" hidden /></span>
        <div>
          <p class="lcd-kicker">Your profile · what others see</p>
          <h1 id="acct-display">Your account</h1>
          <div class="profile-line">
            <span class="role-badge" id="acct-badge" hidden></span>
            <span id="acct-pub-bio"></span>
            <a id="acct-pub-link" target="_blank" rel="noopener" hidden></a>
          </div>
        </div>
        <p>Only your name, picture, bio and link are public. Your email address is never shown on the site.</p>
      </section>

      <div class="acct">
        <div class="acct-main">
          <section class="acct-card">
            <h2>Edit profile</h2>
            <form id="acct-form" class="acct-form" novalidate>
              <label>
                <span>Display name</span>
                <input class="field" id="acct-name" name="displayName" maxlength="40" required autocomplete="nickname" />
                <small>Shown next to anything you share.</small>
              </label>
              <label>
                <span>About you <em>(optional)</em></span>
                <textarea class="field" id="acct-bio" name="bio" maxlength="280" rows="3"></textarea>
              </label>
              <label>
                <span>Link <em>(optional)</em></span>
                <input class="field" id="acct-link" name="link" type="url" maxlength="200" placeholder="https://" />
              </label>
              <div class="acct-actions">
                <button type="submit" class="btn">Save profile</button>
                <span id="acct-status" role="status"></span>
              </div>
            </form>
          </section>

          <section class="acct-card" id="ipods">
            <h2>Your iPods <span class="badge-count" id="ipods-count">0</span></h2>
            <p>Add every iPod you own, even two of the same model. When you say whether something works, you pick which one you tried it on, so the count lands on the right model. Only you see this list and the nicknames.</p>
            <ul class="ipod-shelf" id="ipod-shelf"><li class="aside-note">Loading…</li></ul>
            <form id="ipod-add" class="ipod-add" novalidate>
              <label>
                <span>Model</span>
                <span class="select">
                  <select class="field" id="ipod-model" required>
                    {devices.map((d) => <option value={d.id}>{d.name} ({d.years})</option>)}
                  </select>
                  <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
                </span>
              </label>
              <label>
                <span>Nickname <em>(optional)</em></span>
                <input class="field" id="ipod-label" maxlength="40" placeholder="Black 256GB, iFlash" />
              </label>
              <button type="submit" class="btn">Add iPod</button>
            </form>
            <p id="ipod-status" class="aside-note" role="status"></p>
            <template id="ipod-looks">
              {devices.map((d) => <span data-model={d.id}><IpodShape look={d.look} scale={0.6} /></span>)}
            </template>
          </section>

          <section class="acct-themes">
            <h2>Your themes</h2>
            <div id="acct-theme-list" class="acct-theme-list"><p class="aside-note">Loading…</p></div>
            <p><a class="btn btn-quiet" href={href("/themes/submit/")}>Share a theme</a> <a class="btn btn-quiet" href={href("/suggest/")}>Suggest a listing</a></p>
          </section>
        </div>

        <div class="acct-side">
          <section class="acct-card">
            <h2>Your guide</h2>
            <fieldset class="role-inline">
              <legend class="sr-text">Which describes you?</legend>
              <label class="theme-check"><input type="radio" name="acct-role" value="user" /><span>I use an iPod</span></label>
              <label class="theme-check"><input type="radio" name="acct-role" value="creator" /><span>I make things for iPods</span></label>
            </fieldset>
            <p><a class="more-link" id="acct-guide" href={href("/start/ipod-users/")}>Open your guide →</a> <span id="acct-role-status" role="status"></span></p>
          </section>

          {ALERTS_ON && (
            <section class="acct-card" id="alerts">
              <h2>Release alerts</h2>
              <p id="alert-state" class="aside-note">Loading…</p>
              <div id="alert-form" class="acct-form" hidden>
                <p>An email when new firmware or a new app version comes out for the iPods you tick. Nothing else is sent, and every email has a link that stops them. <a href={href("/privacy/")}>Privacy policy</a></p>
                <p id="alert-pill" hidden><span class="pill pill-stable">On</span></p>
                <fieldset class="theme-devices">
                  <legend>Tell me about</legend>
                  <div id="alert-picks" class="tag-picks">
                    <label class="tag-pick"><input type="checkbox" value={EVERY_IPOD} /><span>Every release</span></label>
                    {followable.map((d) => <label class="tag-pick"><input type="checkbox" value={d.id} /><span>{d.short}</span></label>)}
                  </div>
                </fieldset>
                <p class="news-address">Emails go to <strong id="alert-email"></strong>, the address you signed in with.</p>
                <div class="acct-actions">
                  <button type="button" class="btn" id="alert-save">Save</button>
                  <button type="button" class="btn btn-quiet" id="alert-stop" hidden>Stop all alerts</button>
                  <span id="alert-status" role="status"></span>
                </div>
              </div>
              <p id="alert-error" class="signin-error" role="alert" hidden></p>
            </section>
          )}

          <section class="acct-card" id="newsletter">
            <h2>Newsletter</h2>
            <p id="news-state" class="aside-note">Loading…</p>
            <div id="news-off" class="acct-form" hidden>
              <p>Occasional emails about new firmware, themes and guides. We use your name and email address for this and nothing else, never share them, and you can unsubscribe at any time. <a href={href("/privacy/")}>Privacy policy</a></p>
              <label class="news-field">
                <span>Name to greet you by</span>
                <input class="field" id="news-name" maxlength="80" autocomplete="name" />
              </label>
              <p class="news-address">Emails go to <strong id="news-email"></strong>, the address you signed in with.</p>
              <div><button type="button" class="btn" id="news-subscribe">Subscribe</button></div>
            </div>
            <div id="news-on" class="acct-form" hidden>
              <p><span class="pill pill-stable">Subscribed</span></p>
              <p>News goes to <strong id="news-as"></strong>.</p>
              <div><button type="button" class="btn btn-quiet" id="news-unsubscribe">Unsubscribe</button></div>
            </div>
            <p id="news-error" class="signin-error" role="alert" hidden></p>
          </section>

          <section class="acct-card" id="acct-subscribers" hidden>
            <h2>Newsletter list <span class="badge-count" id="subs-count">0</span></h2>
            <p>Only you, as admin, can see this. Use it only to send the newsletter people signed up for.</p>
            <p><a class="btn btn-quiet" id="subs-download" download="quitanda-subscribers.csv" href="#">Download the list (CSV)</a></p>
          </section>

          <section class="acct-card">
            <h2>Your data</h2>
            <p>Download everything Quitanda holds about you in one file. <a href={href("/gdpr/")}>Your data rights</a></p>
            <p class="acct-actions"><button type="button" class="btn btn-quiet" id="acct-export">Download my data</button> <span id="acct-export-status" role="status"></span></p>
          </section>

          <section class="acct-danger">
            <h2>Delete your account</h2>
            <p>This removes your profile, your settings, your iPods, your newsletter record, the themes you shared, the reports you sent and your sign-in. It can't be undone.</p>
            <div class="acct-row">
              <button type="button" class="btn btn-danger" id="acct-delete">Delete my account</button>
              <button type="button" class="btn btn-soft" id="acct-signout">Sign out</button>
            </div>
            <div id="acct-confirm" hidden>
              <p><strong>Delete your account for good?</strong></p>
              <button type="button" class="btn btn-danger" id="acct-delete-yes">Yes, delete it</button>
              <button type="button" class="btn btn-quiet" id="acct-delete-no">Keep my account</button>
            </div>
            <p id="acct-delete-error" class="signin-error" role="alert" hidden></p>
          </section>
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  import { onUser, loadAuth } from "../scripts/account.js";
  import { h, link, statusPill, fmtDate } from "../scripts/theme-ui.js";

  const $ = (id) => document.getElementById(id);
  let me = null;

  onUser(async (user) => {
    me = user;
    $("acct-loading").hidden = true;
    $("acct-out").hidden = !!user;
    $("acct-in").hidden = !user;
    if (!user) return;
    const { loadProfile, isAdmin } = await loadAuth();
    const profile = (await loadProfile(user.uid)) || {};
    $("acct-name").value = profile.displayName || user.displayName || "";
    $("acct-bio").value = profile.bio || "";
    $("acct-link").value = profile.link || "";
    showBanner({ displayName: $("acct-name").value, bio: profile.bio, link: profile.link }, user);
    $("acct-admin").hidden = !(await isAdmin(user.uid));

    setUpMember(user, await isAdmin(user.uid));
    setUpIpods();

    const { myThemes } = await import("../lib/themes-write.js");
    const themes = await myThemes().catch(() => []);
    $("acct-theme-list").replaceChildren(
      ...(themes.length
        ? themes.map((t) =>
            h("a", { class: "acct-theme", href: link(`/themes/view/?id=${encodeURIComponent(t.id)}`) },
              h("strong", {}, t.name),
              statusPill(t.status),
              h("span", {}, fmtDate(t.createdAt)),
              t.status === "rejected" && t.reviewNote ? h("em", {}, t.reviewNote) : null
            )
          )
        : [h("p", { class: "aside-note" }, "You haven't shared a theme yet.")])
    );
  });

  const member = () => import("../lib/member.js");
  const GUIDES = { user: "/start/ipod-users/", creator: "/start/makers/" };
  const BADGES = { user: "iPod owner", creator: "Maker" };

  // The top of the page: the profile as other people see it.
  function showBanner(profile, user) {
    const name = profile.displayName || "Your account";
    $("acct-display").textContent = name;
    $("acct-initial").textContent = name.slice(0, 1).toUpperCase();
    $("acct-initial").hidden = !!user.photoURL;
    $("acct-photo").hidden = !user.photoURL;
    if (user.photoURL) $("acct-photo").src = user.photoURL;
    $("acct-pub-bio").textContent = profile.bio || "";
    const linkEl = $("acct-pub-link");
    linkEl.hidden = !profile.link;
    if (profile.link) {
      linkEl.href = profile.link;
      linkEl.textContent = profile.link.replace(/^https:\/\//, "").replace(/\/$/, "");
    }
  }
  function showBadge(role) {
    $("acct-badge").hidden = !BADGES[role];
    $("acct-badge").textContent = BADGES[role] || "";
  }

  function saveFile(name, type, text, anchor) {
    const url = URL.createObjectURL(new Blob([text], { type }));
    const a = anchor || h("a", { download: name });
    a.href = url;
    if (!anchor) { a.click(); setTimeout(() => URL.revokeObjectURL(url), 5000); }
  }

  function showNewsletter(subscription, m) {
    $("news-state").hidden = true;
    $("news-error").hidden = true;
    if (!m.canSubscribe() && !subscription) {
      $("news-state").hidden = false;
      $("news-state").textContent = "Your sign-in has no verified email address, so the newsletter isn’t available for this account.";
      return;
    }
    $("news-on").hidden = !subscription;
    $("news-off").hidden = !!subscription;
    if (subscription) $("news-as").textContent = `${subscription.name} (${subscription.email})`;
    else $("news-email").textContent = m.myEmail();
  }

  async function setUpMember(user, admin) {
    const m = await member();
    const [settings, subscription] = await Promise.all([m.loadMember(), m.loadSubscription().catch(() => null)]);
    $("acct-welcome").hidden = !!settings?.role;
    showBadge(settings?.role);
    document.querySelectorAll('[name="acct-role"]').forEach((radio) => (radio.checked = radio.value === settings?.role));
    $("acct-guide").href = link(GUIDES[settings?.role] || "/welcome/");
    $("news-name").value = user.displayName || "";
    showNewsletter(subscription, m);
    showAlerts();

    if (admin) {
      const list = await m.listSubscribers().catch(() => []);
      $("subs-count").textContent = list.length;
      // Cells starting with =, +, - or @ are quoted so a spreadsheet never runs them as formulas.
      const cell = (v) => `"${String(v ?? "").replace(/^([=+\-@])/, "'$1").replace(/"/g, '""')}"`;
      const csv = ["name,email,subscribed", ...list.map((s) => [s.name, s.email, s.subscribedAt].map(cell).join(","))].join("\n");
      saveFile("quitanda-subscribers.csv", "text/csv", csv, $("subs-download"));
      $("acct-subscribers").hidden = false;
    }
  }

  document.querySelectorAll('[name="acct-role"]').forEach((radio) =>
    radio.addEventListener("change", async () => {
      $("acct-role-status").textContent = "Saving…";
      try {
        await (await member()).saveMember(radio.value);
        $("acct-guide").href = link(GUIDES[radio.value]);
        $("acct-welcome").hidden = true;
        showBadge(radio.value);
        $("acct-role-status").textContent = "Saved";
      } catch {
        $("acct-role-status").textContent = "Couldn’t save. Try again.";
      }
    })
  );

  // Your iPods: the list reports are tagged with.
  const DEVICE_NAMES = Object.fromEntries([...$("ipod-model").options].map((o) => [o.value, o.textContent.replace(/ \(.*\)$/, "")]));
  const myIpods = () => import("../lib/my-ipods.js");
  let ipods = [];

  function drawIpods() {
    $("ipods-count").textContent = ipods.length;
    const look = (model) => $("ipod-looks").content.querySelector(`[data-model="${model}"]`)?.cloneNode(true);
    $("ipod-shelf").replaceChildren(
      ...(ipods.length
        ? ipods.map((p) =>
            h("li", { class: "ipod-row" },
              h("span", { class: "ipod-look" }, look(p.model)),
              h("span", { class: "ipod-name" },
                h("strong", {}, p.label || DEVICE_NAMES[p.model] || p.model),
                p.label ? h("span", {}, DEVICE_NAMES[p.model] || p.model) : null
              ),
              h("button", { type: "button", class: "btn btn-soft", "data-remove": p.id, "aria-label": `Remove ${p.label || DEVICE_NAMES[p.model]}` }, "Remove")
            )
          )
        : [h("li", { class: "aside-note" }, "No iPods yet. Add the ones you own, and you can say whether firmware and apps work on them.")])
    );
  }

  async function setUpIpods() {
    try {
      const picked = localStorage.getItem("cwf-device");
      if (DEVICE_NAMES[picked]) $("ipod-model").value = picked;
    } catch { /* private window */ }
    try {
      ipods = await (await myIpods()).loadMyIpods();
    } catch {
      $("ipod-status").textContent = "Couldn’t load your iPods. Reload to try again.";
    }
    drawIpods();
  }

  $("ipod-add").addEventListener("submit", async (e) => {
    e.preventDefault();
    const m = await myIpods();
    if (ipods.length >= m.MAX_IPODS) return ($("ipod-status").textContent = `That’s ${m.MAX_IPODS} iPods, the most a list can hold.`);
    $("ipod-status").textContent = "Adding…";
    try {
      ipods.push(await m.addIpod($("ipod-model").value, $("ipod-label").value));
      $("ipod-label").value = "";
      $("ipod-status").textContent = "Added";
      drawIpods();
    } catch {
      $("ipod-status").textContent = "Couldn’t add it. Try again in a moment.";
    }
  });

  $("ipod-shelf").addEventListener("click", async (e) => {
    const id = e.target.closest("[data-remove]")?.dataset.remove;
    if (!id) return;
    $("ipod-status").textContent = "Removing…";
    try {
      await (await myIpods()).removeIpod(id);
      ipods = ipods.filter((p) => p.id !== id);
      $("ipod-status").textContent = "Removed. Reports you sent for it still count.";
      drawIpods();
    } catch {
      $("ipod-status").textContent = "Couldn’t remove it. Try again in a moment.";
    }
  });

  async function newsletter(action) {
    const error = $("news-error");
    error.hidden = true;
    try {
      const m = await member();
      await (action === "subscribe" ? m.subscribe($("news-name").value) : m.unsubscribe());
      showNewsletter(await m.loadSubscription(), m);
    } catch (err) {
      error.textContent = err.code ? "That didn’t go through. Try again in a moment." : err.message;
      error.hidden = false;
    }
  }
  /* ---------- release alerts by email ---------- */
  const alerts = () => import("../lib/alerts.js");
  const alertBoxes = () => [...document.querySelectorAll("#alert-picks input")];
  async function showAlerts() {
    if (!$("alerts")) return; // alerts aren't switched on for the site
    const a = await alerts();
    const mine = await a.loadAlerts().catch(() => null);
    $("alert-state").hidden = true;
    if (!a.canGetAlerts()) {
      $("alert-state").hidden = false;
      $("alert-state").textContent = "Your sign-in has no verified email address, so alerts aren’t available for this account.";
      return;
    }
    let stored = null;
    try { stored = localStorage.getItem("cwf-device"); } catch { /* private window */ }
    // Tick what they chose; with nothing chosen yet, suggest the iPod they picked in the shop.
    const ticked = new Set(mine ? mine.devices : stored ? [stored] : []);
    alertBoxes().forEach((box) => (box.checked = ticked.has(box.value)));
    $("alert-email").textContent = mine?.email || a.alertsEmail();
    $("alert-pill").hidden = !mine;
    $("alert-stop").hidden = !mine;
    $("alert-save").textContent = mine ? "Save changes" : "Email me";
    $("alert-form").hidden = false;
  }
  async function changeAlerts(stop) {
    const error = $("alert-error");
    error.hidden = true;
    $("alert-status").textContent = "";
    try {
      const a = await alerts();
      const chosen = alertBoxes().filter((box) => box.checked).map((box) => box.value);
      if (!stop && !chosen.length) throw new Error("Tick at least one, or choose Stop all alerts.");
      await (stop ? a.stopAlerts() : a.saveAlerts(chosen));
      await showAlerts();
      if (stop) alertBoxes().forEach((box) => (box.checked = false));
      $("alert-status").textContent = stop ? "Stopped. Your alert settings are deleted." : "Saved.";
    } catch (err) {
      error.textContent = err.code ? "That didn’t go through. Try again in a moment." : err.message;
      error.hidden = false;
    }
  }
  if ($("alerts")) {
    $("alert-save").addEventListener("click", () => changeAlerts(false));
    $("alert-stop").addEventListener("click", () => changeAlerts(true));
  }

  $("news-subscribe").addEventListener("click", () => newsletter("subscribe"));
  $("news-unsubscribe").addEventListener("click", () => newsletter("unsubscribe"));

  $("acct-export").addEventListener("click", async () => {
    const status = $("acct-export-status");
    status.textContent = "Gathering your data…";
    try {
      const data = await (await member()).exportMyData();
      saveFile("quitanda-my-data.json", "application/json", JSON.stringify(data, null, 2));
      status.textContent = "Downloaded";
    } catch {
      status.textContent = "Couldn’t gather your data. Try again in a moment.";
    }
  });

  $("acct-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = $("acct-status");
    status.textContent = "Saving…";
    try {
      const { saveProfile } = await loadAuth();
      const saved = await saveProfile(me, { displayName: $("acct-name").value, bio: $("acct-bio").value, link: $("acct-link").value });
      showBanner(saved, me);
      status.textContent = "Saved";
    } catch (err) {
      status.textContent = err.code ? "Couldn't save. Try again in a moment." : err.message;
    }
  });

  $("acct-signout").addEventListener("click", async () => {
    const { signOutNow } = await loadAuth();
    await signOutNow();
  });

  $("acct-delete").addEventListener("click", () => {
    $("acct-confirm").hidden = false;
    $("acct-delete").hidden = true;
  });
  $("acct-delete-no").addEventListener("click", () => {
    $("acct-confirm").hidden = true;
    $("acct-delete").hidden = false;
  });
  $("acct-delete-yes").addEventListener("click", async () => {
    const error = $("acct-delete-error");
    error.hidden = true;
    try {
      await (await member()).deleteEverything();
    } catch (err) {
      error.textContent =
        err.code === "auth/requires-recent-login"
          ? "For safety, sign out, sign in again, and then delete your account."
          : "Couldn't delete the account. Try again in a moment.";
      error.hidden = false;
    }
  });
</script>
