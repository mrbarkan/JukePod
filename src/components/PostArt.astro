---
// Artwork for a blog post, built from the shop's own parts.
import Mark from "./Mark.astro";
import IpodShape from "./IpodShape.astro";
import { href } from "../lib/catalog.js";
const { art = "mark" } = Astro.props;
---
<span class={`post-art art-${art}`} aria-hidden="true">
  {art === "themes" && (
    <>
      <span class="mini-console" style="background: #171c22; rotate: -5deg"><span style="background: #050504; color: #f5f1e6">CARBON</span><div><i style="background: #ff6d3f"></i><i style="background: #45c7bd"></i><i style="background: #f4ca54"></i></div></span>
      <span class="shot"><img src={href("/screenshots/rockpod/5.png")} alt="" loading="lazy" /></span>
      <span class="mini-console" style="background: #2a2d3c; border-radius: 0; rotate: 6deg"><span style="background: #000000; color: #00ff00; border-radius: 0">LLAMA ’97</span><div><i style="background: #2b4acf; border-radius: 0"></i><i style="background: #00e23c; border-radius: 0"></i><i style="background: #ffe45c; border-radius: 0"></i></div></span>
    </>
  )}
  {art === "ipods" && (
    <>
      <IpodShape look="full" />
      <IpodShape look="mini" />
      <IpodShape look="classic" scale={1.3} />
      <IpodShape look="video" />
      <IpodShape look="nano" />
    </>
  )}
  {art === "mark" && <Mark size={132} />}
</span>
