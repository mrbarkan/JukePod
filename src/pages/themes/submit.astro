---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import ThemeData from "../../components/ThemeData.astro";
import { href, themeTargets } from "../../lib/catalog.js";
const LICENSES = ["CC BY 4.0", "CC BY-SA 4.0", "CC0 (public domain)", "MIT", "GPL-2.0", "All rights reserved"];
---
<Base title="Share a theme" description="Share a theme you made for Rockbox, its forks or CrateDigger, with screenshots. Tag the firmware it runs on and credit what it remixes." section="themes">
  <main class="wrap page narrow">
    <a class="back" href={href("/themes/")}><Icon name="back" />All themes</a>
    <header class="intro">
      <h1 id="submit-title">Share a theme</h1>
      <p>Upload the theme and a few screenshots. It appears in the gallery once it has been checked. Making one for Rockbox? <a href={href("/themes/rockbox/")}>How to package a Rockbox theme</a>.</p>
    </header>

    <p id="submit-loading" class="aside-note">Checking whether you're signed in…</p>
    <section id="submit-out" hidden>
      <p>You need to be signed in to share a theme. Use <strong>Sign in</strong> at the top of the page.</p>
    </section>

    <form id="submit-form" class="acct-form theme-form" novalidate hidden>
      <label>
        <span>What is it for?</span>
        <span class="select">
          <select class="field" id="t-target" required>
            {themeTargets.map((t) => <option value={t.id}>{t.name}</option>)}
          </select>
          <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
        </span>
      </label>

      <fieldset id="t-also-box" class="theme-devices" hidden>
        <legend>Also works on <em>(optional)</em></legend>
        <small>Tick the other firmware you've tried it on. Rockbox themes often run on its forks too.</small>
        <div id="t-also" class="tag-picks"></div>
      </fieldset>

      <label>
        <span>Theme file</span>
        <input class="field" id="t-file" type="file" accept=".zip,.json,application/zip,application/json" required />
        <small id="t-file-help"></small>
      </label>
      <div id="t-inspect" class="theme-inspect" hidden></div>

      <label>
        <span>Name</span>
        <input class="field" id="t-name" maxlength="60" required />
      </label>
      <label>
        <span>Made for version <em>(optional)</em></span>
        <input class="field" id="t-version" maxlength="40" placeholder="for example 5.5" />
        <small>Themes often break between versions, so this helps people pick the right one.</small>
      </label>
      <fieldset id="t-devices-box" class="theme-devices" hidden>
        <legend>Which iPods does it fit?</legend>
        <div id="t-devices"></div>
      </fieldset>
      <label>
        <span>Description <em>(optional)</em></span>
        <textarea class="field" id="t-description" rows="4" maxlength="1000"></textarea>
      </label>
      <label>
        <span>License</span>
        <span class="select">
          <select class="field" id="t-license">
            {LICENSES.map((l) => <option value={l}>{l}</option>)}
          </select>
          <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
        </span>
        <small>How others may use your theme.</small>
      </label>

      <fieldset class="theme-remix">
        <legend>Is it a remix? <em>(optional)</em></legend>
        <small>If you started from someone else's theme, link it so they get the credit. Paste a theme's link from this site, or a link from anywhere else. Up to 5.</small>
        <div class="remix-add">
          <input class="field" id="t-remix-url" type="url" inputmode="url" maxlength="300" placeholder="https://…" aria-label="Link to the original theme" />
          <input class="field" id="t-remix-title" maxlength="80" placeholder="Its name (for outside links)" aria-label="Name of the original theme" />
          <button type="button" class="btn btn-quiet" id="t-remix-add">Add</button>
        </div>
        <p id="t-remix-note" class="aside-note" role="status"></p>
        <ul id="t-remix-list" class="remix-list"></ul>
      </fieldset>

      <label>
        <span>Screenshots <em id="t-shots-rule"></em></span>
        <input class="field" id="t-shots" type="file" accept="image/png,image/jpeg,image/webp" multiple />
        <small>Up to 6. PNG, JPEG or WebP. iPod screen captures stay pixel-sharp.</small>
      </label>
      <div id="t-shot-list" class="theme-shot-list"></div>

      <label class="theme-check">
        <input type="checkbox" id="t-rights" required />
        <span>I made this or have the right to share it, and it contains no Apple fonts, icons or artwork.</span>
      </label>

      <div class="acct-actions">
        <button type="submit" class="btn" id="t-send">Send for review</button>
        <span id="t-status" role="status"></span>
      </div>
      <p id="t-error" class="signin-error" role="alert" hidden></p>
    </form>

    <section id="submit-done" hidden>
      <h2>Sent for review</h2>
      <p>Your theme will appear in the gallery once it has been checked. You can follow it from <a href={href("/account/")}>your account page</a>.</p>
      <p><a class="btn btn-quiet" id="done-view" href={href("/themes/")}>See your theme</a></p>
    </section>
  </main>
  <ThemeData />
</Base>

<script>
  import { onUser } from "../../scripts/account.js";
  import { h, pageData, link, consoleSwatch, hostOf } from "../../scripts/theme-ui.js";

  const { targets, devices } = pageData();
  const $ = (id) => document.getElementById(id);
  const fileTools = () => import("../../lib/theme-file.js");
  let inspected = null; // result of checking the chosen file
  let shots = []; // prepared screenshots
  let busy = false;

  const target = () => targets.find((t) => t.id === $("t-target").value);
  const params = new URLSearchParams(location.search);
  if (targets.some((t) => t.id === params.get("for"))) $("t-target").value = params.get("for");
  let remixes = []; // { url, title, themeId? }

  const firmwares = targets.filter((t) => t.kind === "firmware");
  // Ticked tags are remembered, so switching what it's for doesn't lose them.
  const ticked = new Set();
  const alsoOn = () => firmwares.map((f) => f.id).filter((id) => ticked.has(id) && id !== $("t-target").value);
  onUser((user) => {
    $("submit-loading").hidden = true;
    if ($("submit-done").hidden) {
      $("submit-out").hidden = !!user;
      $("submit-form").hidden = !user;
    }
  });

  function showError(message) {
    $("t-error").textContent = message || "";
    $("t-error").hidden = !message;
  }

  function onTargetChange() {
    const t = target();
    const forApp = t.kind === "app";
    $("t-file-help").textContent = forApp
      ? "Zip the whole .cdtheme folder, or choose a bare theme .json. 5 MB at most."
      : "A .zip that unpacks into the iPod's .rockbox folder. 5 MB at most. No plugins or firmware files.";
    $("t-shots-rule").textContent = forApp ? "(optional)" : "(at least one)";
    $("t-devices-box").hidden = forApp;
    $("t-also-box").hidden = forApp;
    $("t-also").replaceChildren(
      ...(forApp ? [] : firmwares.filter((f) => f.id !== t.id)).map((f) =>
        h("label", { class: "tag-pick" },
          h("input", { type: "checkbox", value: f.id, checked: ticked.has(f.id), onchange: (e) => { e.target.checked ? ticked.add(f.id) : ticked.delete(f.id); drawDevices(); } }),
          h("span", {}, f.name))
      )
    );
    $("submit-title").textContent = `Share a ${t.name} theme`;
    drawDevices();
    if ($("t-file").files[0]) inspect();
  }

  // The iPods to choose from are those the chosen firmware runs on, and
  // those of any it is also tagged with. Choices already made are kept.
  let deviceChoices = new Map();
  function drawDevices() {
    for (const input of $("t-devices").querySelectorAll("input")) deviceChoices.set(input.value, input.checked);
    const ids = [target(), ...alsoOn().map((id) => targets.find((t) => t.id === id))].filter(Boolean).flatMap((t) => t.devices);
    const unique = Object.keys(devices).filter((d) => ids.includes(d));
    $("t-devices").replaceChildren(
      ...unique.map((d) => h("label", { class: "theme-check" }, h("input", { type: "checkbox", value: d, checked: deviceChoices.get(d) ?? true }), h("span", {}, devices[d] || d)))
    );
  }

  /* ---------- remix sources ---------- */
  const remixNote = (text) => ($("t-remix-note").textContent = text || "");
  function drawRemixes() {
    $("t-remix-list").replaceChildren(
      ...remixes.map((r, i) =>
        h("li", {},
          h("span", { class: "remix-where" }, r.themeId ? "On Quitanda" : hostOf(r.url)),
          h("strong", {}, r.title),
          h("button", { type: "button", class: "share-btn", onclick: () => { remixes.splice(i, 1); drawRemixes(); } }, "Remove")
        )
      )
    );
    $("t-remix-add").disabled = remixes.length >= 5;
  }

  async function addRemix(text, title = "") {
    remixNote("");
    const raw = String(text || "").trim();
    if (!raw) return remixNote("Paste a link to the original theme.");
    if (remixes.length >= 5) return remixNote("Five at most.");
    const { themeIdFromLink, getApproved } = await import("../../lib/themes-read.js");
    const themeId = themeIdFromLink(raw);
    if (themeId) {
      if (remixes.some((r) => r.themeId === themeId)) return remixNote("That one is already on the list.");
      remixNote("Looking it up…");
      const original = await getApproved(themeId).catch(() => null);
      if (!original || original.status !== "approved") return remixNote("That theme isn't in the gallery. Check the link.");
      remixes.push({ themeId, title: original.name.slice(0, 80) });
      remixNote(original.license === "All rights reserved"
        ? `Added. ${original.ownerName || "Its author"} keeps all rights to that theme, so ask them before you share a remix.`
        : `Added ${original.name} by ${original.ownerName || "someone"}.`);
    } else {
      let url;
      try { url = new URL(raw); } catch { return remixNote("That doesn't look like a link. It should start with https://"); }
      if (url.protocol !== "https:") return remixNote("Use a link that starts with https://");
      if (url.href.length > 300) return remixNote("That link is too long.");
      if (remixes.some((r) => r.url === url.href)) return remixNote("That one is already on the list.");
      if (/(^|\.)(quitanda\.mrbarkan\.com|mrbarkan\.github\.io)$/.test(url.hostname) || url.origin === location.origin) {
        return remixNote("That's a page on this site, not a theme. Paste the link of the theme's own page.");
      }
      remixes.push({ url: url.href, title: String(title).trim().slice(0, 80) || hostOf(url.href) });
      remixNote("");
    }
    $("t-remix-url").value = "";
    $("t-remix-title").value = "";
    drawRemixes();
  }
  $("t-remix-add").addEventListener("click", () => addRemix($("t-remix-url").value, $("t-remix-title").value));
  for (const id of ["t-remix-url", "t-remix-title"]) {
    $(id).addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); $("t-remix-add").click(); } });
  }

  async function inspect() {
    const file = $("t-file").files[0];
    const box = $("t-inspect");
    inspected = null;
    showError("");
    if (!file) return (box.hidden = true);
    box.hidden = false;
    box.replaceChildren("Checking the file…");
    const { inspectThemeFile } = await fileTools();
    const result = await inspectThemeFile(file, target().id);
    if (!result.ok) {
      box.replaceChildren(h("p", { class: "signin-error" }, result.problems.join(" ")));
      return;
    }
    inspected = result;
    if (result.name && !$("t-name").value) $("t-name").value = result.name;
    if (result.version && !$("t-version").value && target().kind !== "app") $("t-version").value = result.version;
    box.replaceChildren(
      ...[consoleSwatch(result.swatch, result.name || file.name)].filter(Boolean),
      h("p", {}, h("strong", {}, "Looks good. "), `${result.fileCount} ${result.fileCount === 1 ? "file" : "files"}, ${Math.max(1, Math.round(file.size / 1024))} KB.`,
        result.author ? ` Author in the file: ${result.author}.` : ""),
      ...(result.warnings || []).map((w) => h("p", { class: "aside-note" }, w))
    );
  }

  function drawShots() {
    $("t-shot-list").replaceChildren(
      ...shots.map((shot, i) =>
        h("figure", {},
          h("img", { src: shot.preview, alt: `Screenshot ${i + 1}`, class: shot.w <= 640 ? "is-pixel" : "" }),
          h("button", { type: "button", class: "share-btn", onclick: () => { URL.revokeObjectURL(shot.preview); shots.splice(i, 1); drawShots(); } }, "Remove")
        )
      )
    );
  }

  $("t-shots").addEventListener("change", async () => {
    showError("");
    const { prepareScreenshot } = await fileTools();
    for (const file of [...$("t-shots").files]) {
      if (shots.length >= 6) { showError("Six screenshots at most. The rest were left out."); break; }
      try {
        const shot = await prepareScreenshot(file);
        shots.push({ ...shot, preview: URL.createObjectURL(shot.blob) });
      } catch (err) {
        showError(err.message);
      }
    }
    $("t-shots").value = "";
    drawShots();
  });

  $("t-target").addEventListener("change", onTargetChange);
  $("t-file").addEventListener("change", inspect);

  $("submit-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    if (busy) return;
    const t = target();
    const name = $("t-name").value.trim();
    if (!$("t-file").files[0]) return showError("Choose the theme file.");
    if (!inspected) return showError("The theme file has a problem. Fix it or choose another file.");
    if (!name) return showError("Give the theme a name.");
    if (t.kind !== "app" && !shots.length) return showError("Add at least one screenshot, so people can see the theme before they install it.");
    if (!$("t-rights").checked) return showError("Confirm that you have the right to share this theme.");
    showError("");
    busy = true;
    $("t-send").disabled = true;
    try {
      const { submitTheme } = await import("../../lib/themes-write.js");
      const id = await submitTheme(
        {
          file: $("t-file").files[0],
          shots,
          swatch: inspected.swatch,
          details: {
            name,
            target: t.id,
            targetVersion: $("t-version").value,
            description: $("t-description").value,
            license: $("t-license").value,
            devices: t.kind === "app" ? [] : [...$("t-devices").querySelectorAll("input:checked")].map((i) => i.value),
            alsoOn: t.kind === "app" ? [] : alsoOn(),
            remixOf: remixes,
          },
        },
        (step) => ($("t-status").textContent = step)
      );
      $("submit-form").hidden = true;
      $("done-view").href = link(`/themes/view/?id=${encodeURIComponent(id)}`);
      $("submit-done").hidden = false;
      window.scrollTo({ top: 0 });
    } catch (err) {
      $("t-status").textContent = "";
      showError(err.code ? "The upload didn't go through. Check your connection and try again." : err.message);
    } finally {
      busy = false;
      $("t-send").disabled = false;
    }
  });

  onTargetChange();
  // "Remix this" on a theme's page links here with the original filled in.
  if (params.get("remix")) addRemix(new URL(link(`/themes/view/?id=${encodeURIComponent(params.get("remix"))}`), location.href).href);
</script>
