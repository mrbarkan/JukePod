rules_version = '2';

// Quitanda's database rules.
//   users        public profiles, written only by their owner
//   members      private settings (iPod user or maker), seen only by their owner
//     /ipods     the iPods they own, one document each (a model and a nickname),
//                so reports can say which of their iPods they were for
//   subscribers  newsletter opt-ins: a name and the email the person signed in with
//   admins   one document per admin, named by user ID; created in the console only
//   themes   shared themes; hidden until an admin approves them. worksOn lists the
//            firmware they run on; remixOf links the themes they remix
//   reports  "works on my iPod" reports, one per person, listing and iPod they own.
//            Older reports name only the model and are still counted
//   flags    reports of a problem with a theme; read by admins and their sender
//   suggestions  listings people suggest adding or fixing; read by admins and their
//            sender, and by anyone once added, if the sender asked to be credited
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSlug(value) {
      return value is string && value.size() <= 60 && value.matches('^[a-z0-9-]+$');
    }
    // "p" and eight letters or digits: never the same as a model ID.
    function isIpodId(value) {
      return value is string && value.matches('^p[a-z0-9]{8}$');
    }
    function optionalText(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }
    // True for a download link to a file this owner uploaded to the site's
    // own storage. Stops a theme from pointing at files hosted elsewhere.
    function ownFile(url, uid) {
      return url is string && url.size() <= 600
        && url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/quitanda-95fa7[.]firebasestorage[.]app/o/themes%2F' + uid + '%2F.*');
    }
    function ownShot(shots, index, uid) {
      return shots.size() <= index || (shots[index] is map && ownFile(shots[index].url, uid));
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);

      function validProfile(data) {
        return data.keys().hasOnly(['displayName', 'photoURL', 'bio', 'link', 'updatedAt'])
          && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
          && optionalText(data, 'photoURL', 500)
          && optionalText(data, 'bio', 280)
          && (!('link' in data) || (data.link is string && data.link.size() <= 200 && data.link.matches('^https://.*')));
      }
    }

    // Private settings chosen on the welcome page.
    match /members/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['role', 'onboardedAt', 'updatedAt'])
        && request.resource.data.role in ['user', 'creator'];
      allow delete: if isOwner(uid);

      // Each iPod gets its own ID, so two of the same model stay apart.
      match /ipods/{ipodId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isIpodId(ipodId)
          && request.resource.data.keys().hasOnly(['model', 'label', 'addedAt'])
          && isSlug(request.resource.data.model)
          && optionalText(request.resource.data, 'label', 40);
      }
    }

    // The newsletter list. A record exists only while someone is opted in:
    // unsubscribing deletes it. The address must be the verified one the
    // person signed in with, so nobody can sign up someone else.
    match /subscribers/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'consent', 'subscribedAt'])
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.consent is string && request.resource.data.consent.size() <= 40;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /themes/{themeId} {
      allow read: if resource.data.status == 'approved' || isOwner(resource.data.ownerUid) || isAdmin();

      // A new theme always starts hidden, owned by whoever is signed in.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validTheme(request.resource.data);

      // An owner's edit sends the theme back for review. An admin may only
      // change the review fields.
      allow update: if (isOwner(resource.data.ownerUid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == 'pending'
          && validTheme(request.resource.data))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedAt'])
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && optionalText(request.resource.data, 'reviewNote', 500));

      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();

      function validTheme(data) {
        return data.keys().hasOnly(['ownerUid', 'ownerName', 'name', 'target', 'targetVersion', 'devices', 'description',
            'license', 'file', 'screenshots', 'swatch', 'worksOn', 'remixOf', 'remixIds',
            'status', 'reviewNote', 'reviewedAt', 'createdAt', 'updatedAt'])
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
          && data.ownerName is string && data.ownerName.size() <= 40
          && isSlug(data.target)
          && optionalText(data, 'targetVersion', 40)
          && optionalText(data, 'description', 1000)
          && optionalText(data, 'license', 80)
          && (!('devices' in data) || (data.devices is list && data.devices.size() <= 20))
          && data.file is map && ownFile(data.file.url, data.ownerUid)
          && optionalText(data.file, 'name', 120)
          && data.screenshots is list && data.screenshots.size() <= 6
          && ownShot(data.screenshots, 0, data.ownerUid) && ownShot(data.screenshots, 1, data.ownerUid)
          && ownShot(data.screenshots, 2, data.ownerUid) && ownShot(data.screenshots, 3, data.ownerUid)
          && ownShot(data.screenshots, 4, data.ownerUid) && ownShot(data.screenshots, 5, data.ownerUid)
          && (!('swatch' in data) || (data.swatch is map && data.swatch.size() <= 12))
          // What it runs on: the firmware or app it was made for, then any it is tagged with.
          && data.worksOn is list && data.worksOn.size() >= 1 && data.worksOn.size() <= 8
          && data.worksOn[0] == data.target
          && slugAt(data.worksOn, 1) && slugAt(data.worksOn, 2) && slugAt(data.worksOn, 3)
          && slugAt(data.worksOn, 4) && slugAt(data.worksOn, 5) && slugAt(data.worksOn, 6) && slugAt(data.worksOn, 7)
          // What it remixes: themes on this site (by ID) or links to anywhere else.
          && (!('remixOf' in data) || (data.remixOf is list && data.remixOf.size() >= 1 && data.remixOf.size() <= 5
            && sourceAt(data.remixOf, 0) && sourceAt(data.remixOf, 1) && sourceAt(data.remixOf, 2)
            && sourceAt(data.remixOf, 3) && sourceAt(data.remixOf, 4)))
          && (!('remixIds' in data) || ('remixOf' in data && data.remixIds is list && data.remixIds.size() >= 1 && data.remixIds.size() <= 5
            && themeIdAt(data.remixIds, 0) && themeIdAt(data.remixIds, 1) && themeIdAt(data.remixIds, 2)
            && themeIdAt(data.remixIds, 3) && themeIdAt(data.remixIds, 4)));
      }
      function slugAt(list, index) {
        return list.size() <= index || isSlug(list[index]);
      }
      function isThemeId(value) {
        return value is string && value.matches('^[A-Za-z0-9]{1,40}$');
      }
      function themeIdAt(list, index) {
        return list.size() <= index || isThemeId(list[index]);
      }
      // Each source is a theme on this site (by ID) or a link elsewhere, never both.
      function sourceAt(list, index) {
        return list.size() <= index || (list[index] is map
          && list[index].title is string && list[index].title.size() >= 1 && list[index].title.size() <= 80
          && ((list[index].keys().hasOnly(['title', 'themeId']) && isThemeId(list[index].themeId))
            || (list[index].keys().hasOnly(['title', 'url'])
              && list[index].url is string && list[index].url.size() <= 300 && list[index].url.matches('^https://[^ ]+$'))));
      }
    }

    // A report names one of the sender's own iPods, and its model must match.
    // Reports sent before iPods were listed name only the model; those can
    // still be replaced the old way by pages loaded before this change.
    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isSlug(request.resource.data.itemId)
        && isSlug(request.resource.data.deviceId)
        && request.resource.data.keys().hasOnly(['uid', 'itemId', 'deviceId', 'ipodId', 'works', 'version', 'note', 'updatedAt'])
        && request.resource.data.works is bool
        && optionalText(request.resource.data, 'version', 40)
        && optionalText(request.resource.data, 'note', 280)
        && (('ipodId' in request.resource.data)
          ? (isIpodId(request.resource.data.ipodId)
            && reportId == request.auth.uid + '_' + request.resource.data.itemId + '_' + request.resource.data.ipodId
            && get(/databases/$(database)/documents/members/$(request.auth.uid)/ipods/$(request.resource.data.ipodId)).data.model == request.resource.data.deviceId)
          : reportId == request.auth.uid + '_' + request.resource.data.itemId + '_' + request.resource.data.deviceId);
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // Listings people suggest: a new firmware, app or mod, or a fix to one.
    // Only the sender and admins see one, until an admin marks it added; then
    // it shows on the thank-you list, if the sender asked to be credited.
    match /suggestions/{suggestionId} {
      allow read: if isOwner(resource.data.uid) || isAdmin()
        || (resource.data.status == 'added' && resource.data.credit == true);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'action', 'itemId', 'title', 'url', 'details', 'credit', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.kind in ['firmware', 'app', 'mod', 'other']
        && request.resource.data.action in ['add', 'fix']
        && (!('itemId' in request.resource.data) || isSlug(request.resource.data.itemId))
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
        && (!('url' in request.resource.data) || (request.resource.data.url is string
          && request.resource.data.url.size() <= 300 && request.resource.data.url.matches('^https?://[^ ]+$')))
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 1 && request.resource.data.details.size() <= 2000
        && request.resource.data.credit is bool;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedAt'])
        && request.resource.data.status in ['new', 'added', 'declined']
        && optionalText(request.resource.data, 'reviewNote', 500);
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    match /flags/{flagId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'themeId', 'reason', 'createdAt'])
        && request.resource.data.themeId is string && request.resource.data.themeId.size() <= 60
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 500;
      // The sender may see and remove their own reports, so deleting an
      // account can take them along.
      allow read, delete: if isAdmin() || isOwner(resource.data.uid);
      allow update: if false;
    }
  }
}
