---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { SITE, clientData, firmwares, apps, mods, href, plain } from "../lib/catalog.js";

// Safe to inline: "<" is escaped so nothing in the data can close the script.
const payload = JSON.stringify({ ...clientData, base: import.meta.env.BASE_URL.replace(/\/$/, "") }).replace(/</g, "\\u003c");
---
<Base section="firmware">
  <main class="wrap page" id="top">
    <div class="top">
      <div class="top-main">
        <header class="intro">
          <h1>Pick your flavor.</h1>
          <p>Your iPod doesn’t have to run what it shipped with. Quitanda stocks every firmware worth trying, the apps that fill it with music, and the parts that keep it going.</p>
        </header>
        <section class="latest" aria-labelledby="latest-title">
          <div class="latest-head">
            <h2 class="latest-title" id="latest-title">Fresh in · <time id="latest-date"></time></h2>
            <button type="button" class="latest-toggle" id="latest-toggle" aria-controls="latest-list" aria-expanded="true">Hide</button>
          </div>
          <ul class="latest-list" id="latest-list"></ul>
        </section>

        <div class="controls" role="search">
          <div class="control">
            <span class="control-label" id="show-label">Show</span>
            <details class="menu" id="show-menu">
              <summary class="field menu-toggle" aria-labelledby="show-label show-current">
                <span id="show-current">All</span>
                <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
              </summary>
              <div class="menu-panel" id="show-options" role="group" aria-labelledby="show-label"></div>
            </details>
          </div>
          <label class="control">
            <span class="control-label">My iPod</span>
            <span class="select">
              <select class="field" id="filter-device"><option value="all">Any iPod</option></select>
              <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
            </span>
          </label>
          <label class="control">
            <span class="control-label">Order</span>
            <span class="select">
              <select class="field" id="filter-order">
                <option value="name">A–Z</option>
                <option value="stars">Most starred</option>
                <option value="updated">Recently updated</option>
              </select>
              <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
            </span>
          </label>
          <input class="field search" id="filter-q" type="search" placeholder="Search…" aria-label="Search the shop" autocomplete="off" />
          <p class="count" id="count" aria-live="polite"></p>
        </div>
      </div>

      <figure class="showcase">
        <div class="ipod" id="ipod">
          <div class="screen">
            <div class="screen-bar">
              <span>Firmware</span>
              <span class="batt" aria-hidden="true"><i></i></span>
            </div>
            <ul class="screen-list" id="screen-list" aria-label="Firmware on this page"></ul>
          </div>
          <div class="wheel" id="wheel" title="Scroll here to move through the list">
            <button type="button" class="wheel-btn w-menu" data-act="menu" aria-label="Back to the top">MENU</button>
            <button type="button" class="wheel-btn w-prev" data-act="prev" aria-label="Previous firmware">
              <svg viewBox="0 0 20 10" aria-hidden="true"><path d="M10 0v10L3 5zM17 0v10l-7-5z" /></svg>
            </button>
            <button type="button" class="wheel-btn w-next" data-act="next" aria-label="Next firmware">
              <svg viewBox="0 0 20 10" aria-hidden="true"><path d="M3 0v10l7-5zM10 0v10l7-5z" /></svg>
            </button>
            <button type="button" class="wheel-btn w-play" data-act="select" aria-label="Open the selected firmware">
              <svg viewBox="0 0 20 10" aria-hidden="true"><path d="M3 0v10l7-5zM12 0h2v10h-2zM16 0h2v10h-2z" /></svg>
            </button>
            <button type="button" class="wheel-center" data-act="select" aria-label="Open the selected firmware"></button>
          </div>
        </div>
        <figcaption>Scroll on the wheel, then press the center.</figcaption>
      </figure>
    </div>

    <div class="pinned" id="pinned"></div>
    <div class="grid" id="grid">
      {/* Shown until the script takes over, and to anything that doesn't run scripts. */}
      <ul class="plain-list">
        {firmwares.map((f) => (<li><a href={href(f.path)}>{f.name}</a> <span>{plain(f.blurb)}</span></li>))}
      </ul>
    </div>
    <p class="empty" id="empty" hidden>Nothing matches. Try another iPod, a different kind, or clear the search.</p>

    <section class="section" id="library-apps" aria-labelledby="apps-title">
      <div class="section-head">
        <h2 id="apps-title">Library apps</h2>
        <p>Software for your computer or phone that puts music on the iPod, edits playlists and backs it up. The iPod and search filters above apply here too.</p>
      </div>
      <div class="apps-controls">
        <div class="segs" id="app-platforms" role="group" aria-label="Platform"></div>
        <p class="count" id="app-count" aria-live="polite"></p>
      </div>
      <div class="grid" id="app-grid">
        <ul class="plain-list">
          {apps.map((a) => (<li><a href={href(a.path)}>{a.name}</a> <span>{plain(a.blurb)}</span></li>))}
        </ul>
      </div>
      <p class="empty" id="app-empty" hidden>No app matches. Try another platform or iPod, or clear the search.</p>
    </section>

    <section class="section" id="mods" aria-labelledby="mods-title">
      <div class="section-head">
        <h2 id="mods-title">Hardware mods</h2>
        <p>Parts you fit inside the iPod: flash storage, bigger batteries, Bluetooth and USB-C. Each one notes how it gets along with the firmware above.</p>
      </div>
      <ul class="mod-teasers">
        {mods.map((m) => (
          <li>
            <a href={href(m.path)}>
              <span class="mod-kind">{m.kind}</span>
              <strong>{m.name}</strong>
              <span>{m.skill}</span>
            </a>
          </li>
        ))}
      </ul>
      <p><a class="more-link" href={href("/mods/")}>All hardware mods <Icon name="ext" /></a></p>
    </section>

    <section class="section" id="compatibility" aria-labelledby="compat-title">
      <div class="section-head">
        <h2 id="compat-title">Compatibility</h2>
        <p>Which firmware runs on which iPod. Partial means it boots, with known gaps.</p>
      </div>
      <div class="table-scroll">
        <table class="matrix" id="matrix"></table>
      </div>
      <p class="legend">
        <span><i class="dot dot-full"></i>Supported</span>
        <span><i class="dot dot-partial"></i>Partial</span>
        <span><i class="dot dot-none"></i>Not supported</span>
      </p>
    </section>

    <section class="section watch" id="watch-list" aria-labelledby="watch-title">
      <div class="section-head">
        <h2 id="watch-title">Still on the tree <span class="badge-count" id="watch-count"></span></h2>
        <p>The watch list: projects that can’t be installed yet. Each moves onto the shelves once it ships.</p>
      </div>
      <ul class="watch-list" id="watch"></ul>
    </section>

    <section class="section submit" id="submit" aria-labelledby="submit-title">
      <div class="submit-copy">
        <h2 id="submit-title">Something missing from the shelves?</h2>
        <p>Send the details and it goes on the page. A listing needs:</p>
        <ul class="checklist">
          <li>Name, maker and a sentence on what it does</li>
          <li>The iPods it fits, and any it only partly supports</li>
          <li>A public download link and the source repository</li>
          <li>Install steps, the license, and checksums if you publish them</li>
        </ul>
      </div>
      <div class="submit-card">
        <p class="submit-label">Every listing lives in one file</p>
        <pre class="code"><code>src/data/catalog.js</code></pre>
        <p>Open a pull request that adds your entry, or open an issue with the details and it will be added for you.</p>
        <div class="submit-actions">
          <a class="btn" href={`${SITE.repo}/issues/new`} target="_blank" rel="noopener">Open an issue</a>
          <a class="btn-plain" href={`${SITE.repo}/edit/main/src/data/catalog.js`} target="_blank" rel="noopener">Edit the file on GitHub ↗</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline set:html={`window.QUITANDA_DATA = ${payload};`} />
  <script is:inline src={href("/assets/app.js")}></script>
</Base>
