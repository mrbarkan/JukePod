---
import Base from "../layouts/Base.astro";
import IpodShape from "../components/IpodShape.astro";
import Badge from "../components/Badge.astro";
import ListingCard from "../components/ListingCard.astro";
import { posts } from "../lib/blog.js";
import { COPY } from "../data/copy.js";
import {
  firmwares, apps, mods, devices, categories, watchlist, latest, recentChanges, updatedOn,
  byId, flavorLabel, fmtDate, isNumbered, plain, href,
} from "../lib/catalog.js";

const C = COPY.home;
const shelf = [...firmwares].sort((a, b) => (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0) || a.name.localeCompare(b.name));
const freshDate = updatedOn > latest.date ? updatedOn : latest.date;
const freshItems = [
  ...recentChanges.map((c) => ({ text: `${byId[c.id].name} ${c.version}`, path: byId[c.id].path })),
  ...latest.lines.flatMap((line) => line.ids.map((id) => byId[id]).filter(Boolean))
    .filter((it) => isNumbered(it.version))
    .map((it) => ({ text: `${it.name} ${it.version}`, path: it.path })),
].filter((x, i, all) => all.findIndex((y) => y.path === x.path) === i).slice(0, 5);
const recentApps = [...apps].sort((a, b) => (b.updated || "").localeCompare(a.updated || "") || a.name.localeCompare(b.name)).slice(0, 4);
const searchable = [
  ...firmwares.map((x) => ({ kind: "Firmware", name: x.name, text: plain(x.blurb), path: x.path, words: `${x.maker} ${(x.features || []).join(" ")}` })),
  ...apps.map((x) => ({ kind: "App", name: x.name, text: plain(x.blurb), path: x.path, words: `${x.maker} ${(x.platforms || []).join(" ")} ${(x.features || []).join(" ")}` })),
  ...mods.map((x) => ({ kind: "Mod", name: x.name, text: plain(x.blurb), path: x.path, words: `${x.maker} ${x.kind} ${x.skill}` })),
  { kind: "Guide", name: "Start here: iPod owners", text: "Find your model, back up, install your first firmware, load music, and recover.", path: "/start/ipod-users/", words: "model number reset disk mode restore" },
  { kind: "Guide", name: "Start here: makers and modders", text: "Get listed, keep your version current, and share themes.", path: "/start/makers/", words: "listing release screenshots" },
  { kind: "Page", name: "Themes", text: "Looks people have made for Rockbox, its forks and CrateDigger.", path: "/themes/", words: "theme skin share upload" },
  { kind: "Page", name: "Compatibility", text: "Which firmware runs on which iPod.", path: "/compatibility/", words: "table matrix supported" },
  ...posts.map((p) => ({ kind: "Blog", name: p.title, text: p.summary, path: `/blog/${p.slug}/`, words: p.kind })),
];
---
<Base section="firmware">
  <main class="wrap page" id="home">
    <section class="section" id="search" hidden>
      <div class="section-head">
        <h2 id="search-title">Search</h2>
        <p><button type="button" class="share-btn" id="search-clear">Clear search</button></p>
      </div>
      <ul class="search-list" id="search-list">
        {searchable.map((r) => (
          <li data-result data-search={`${r.name} ${r.text} ${r.words} ${r.kind}`.toLowerCase()}>
            <a href={href(r.path)}><em>{r.kind}</em><strong>{r.name}</strong><span>{r.text}</span></a>
          </li>
        ))}
      </ul>
      <p class="empty" id="search-empty" hidden>Nothing matches. Try a firmware name, an iPod model, or a feature such as “Cover Flow”.</p>
    </section>

    <div id="shop-all" class="page" style="padding-block: 0">
      <section class="hero">
        <div class="hero-top">
          <div>
            <p class="lcd-kicker">{C.kicker}</p>
            <h1>{C.headline} <em>{C.headlineScript}</em></h1>
            <p class="hero-intro">{C.intro}</p>
          </div>
          <div class="hero-stickers" aria-hidden="true">
            <span class="hs hs-1"><Badge shape="lemon" tone="lemon" {...C.stickers.fresh} /></span>
            <span class="hs hs-2"><Badge shape="round" tone="tomato" wheel {...C.stickers.club} /></span>
            <span class="hs hs-3"><Badge shape="arch" tone="pink" {...C.stickers.beta} /></span>
            <span class="hs hs-4"><Badge shape="diamond" tone="green" script {...C.stickers.brasil} /></span>
          </div>
        </div>

        <div class="picker">
          <div class="picker-head">
            <h2>{C.pickerTitle}{C.pickerHint && <span class="picker-hint" aria-hidden="true">{C.pickerHint}<svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 4v15M5.5 12.5 12 19l6.5-6.5" /></svg></span>}</h2>
            <div>
              <a href={href("/start/ipod-users/#which")}>{C.pickerHelp}</a>
              <button type="button" class="seg" data-device="all" aria-pressed="true">{C.pickerAll}</button>
            </div>
          </div>
          <div class="picker-row" id="picker">
            {devices.map((d) => (
              <button type="button" class="ipod-tile" data-device={d.id} data-short={d.short} data-name={d.name} data-tools={flavorLabel(d.id) === "Tools only" ? "" : undefined} aria-pressed="false">
                <IpodShape look={d.look} />
                <strong>{d.short}</strong>
                <span class="when">{d.years} · {d.model.split(/[ ,]/)[0]}</span>
                <span class="count">{flavorLabel(d.id)}</span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="shop">
        <div class="result-head">
          <div>
            <h2 id="result-title">{firmwares.length} flavors on the shelves</h2>
            <p id="result-note">Every firmware in the shop. Pick your iPod above to see only what runs on it.</p>
          </div>
          <ul class="legend" aria-label="What the ripeness labels mean">
            <li class="pill pill-stable">Ripe · Stable</li>
            <li class="pill pill-beta">Ripening · Beta</li>
            <li class="pill pill-experimental">Unripe · Experimental</li>
            <li class="pill pill-archived">Preserved · Archived</li>
          </ul>
        </div>
        <div class="toolbar">
          <div class="segs" id="kinds" role="group" aria-label="Kind of firmware">
            <button type="button" class="seg" data-kind="all" aria-pressed="true">All</button>
            {categories.map((c) => <button type="button" class="seg" data-kind={c.id} aria-pressed="false">{c.name}</button>)}
          </div>
          <label class="order">
            <span class="control-label">Order</span>
            <span class="select">
              <select class="field" id="order">
                <option value="shelf">Start with Rockbox</option>
                <option value="name">A–Z</option>
                <option value="stars">Most starred</option>
                <option value="updated">Recently updated</option>
              </select>
              <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
            </span>
          </label>
        </div>
        <div class="fw-grid" id="grid">
          {shelf.map((item, i) => <div data-slot style="display: contents" data-shelf={i}><ListingCard item={item} /></div>)}
        </div>
        <p class="empty" id="empty" hidden>Nothing on this shelf runs on this iPod yet. A <a href={href("/apps/")}>library app</a> can still manage its music without iTunes. Know something that belongs here? <a href={href("/suggest/?kind=firmware")} id="empty-suggest">Suggest it</a>.</p>
        <p class="aside-note">Missing a firmware? <a href={href("/suggest/?kind=firmware")}>Suggest a listing</a> and you can be credited when it goes up.</p>
        <p><a class="more-link" href={href("/compatibility/")}>See the full compatibility table →</a></p>
      </section>

      <section class="fresh" aria-label={C.freshTitle}>
        <div>
          <strong>{C.freshTitle} · {fmtDate(freshDate)}</strong>
          {freshItems.map((f) => <a href={href(f.path)}>{f.text}</a>)}
          <a href={href("/themes/")}>{C.freshThemes}</a>
        </div>
      </section>

      <section class="shelves">
        <div class="shelf" id="apps">
          <h2>{C.apps.title}</h2>
          <p>{C.apps.text}</p>
          <ul class="shelf-list">
            {recentApps.map((a) => (
              <li><a href={href(a.path)}><span class="txt"><strong>{a.name}</strong><span>{[(a.platforms || []).join(" · "), a.price].filter(Boolean).join(" · ")}</span></span></a></li>
            ))}
          </ul>
          <a class="more-link" href={href("/apps/")}>All {apps.length} apps →</a>
        </div>
        <div class="shelf">
          <h2>{C.themes.title}</h2>
          <p>{C.themes.text}</p>
          <ul class="shelf-list" id="theme-shelf">
            <li><a href={href("/themes/submit/")}><span class="txt"><strong>{C.themes.firstTitle}</strong><span>{C.themes.firstText}</span></span></a></li>
          </ul>
          <a class="more-link" href={href("/themes/")}>The themes shelf →</a>
        </div>
        <div class="shelf" id="mods">
          <h2>{C.mods.title}</h2>
          <p>{C.mods.text}</p>
          <ul class="shelf-list">
            {mods.slice(0, 4).map((m) => (
              <li><a href={href(m.path)}><span class="txt"><strong>{m.name}</strong><span>{m.skill}</span></span></a></li>
            ))}
          </ul>
          <a class="more-link" href={href("/mods/")}>All {mods.length} mods →</a>
        </div>
      </section>

      {watchlist.length > 0 && (
        <section class="section" id="watch-list">
          <div class="section-head">
            <h2>{C.watchTitle}</h2>
            <p>{C.watchText}</p>
          </div>
          <ul class="watch-list">
            {watchlist.map((w) => (
              <li class="watch-item" id={`watch-${w.id}`}>
                <div class="watch-top"><a href={w.url} target="_blank" rel="noopener">{w.name} ↗</a><span class="maker">{w.maker}</span></div>
                <p>{plain(w.blurb)}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="section" id="guides">
        <div class="section-head"><h2>{C.guidesTitle}</h2></div>
        <ul class="guide-links">
          <li><a href={href("/start/ipod-users/")}><em>Seven steps · about an hour</em><strong>I use an iPod</strong><span>Find your model, back up, install your first firmware, load music, and get it back if something goes wrong.</span></a></li>
          <li><a href={href("/start/makers/")}><em>For firmware, themes, apps and mods</em><strong>I make things for iPods</strong><span>Get listed, keep your version current automatically, and share themes with screenshots.</span></a></li>
        </ul>
      </section>

      <section class="band">
        <div>
          <h2>{C.newsletterTitle}</h2>
          <p>{C.newsletterText}</p>
        </div>
        <a class="btn btn-accent btn-lg" href={href("/account/#newsletter")}>{C.newsletterButton}</a>
      </section>
    </div>
  </main>
</Base>

<script>
  import "../scripts/home.js";
</script>
<script>
  // The themes shelf shows the three newest approved themes, if there are any.
  import { listApproved } from "../lib/themes-read.js";
  import { h, link, preview } from "../scripts/theme-ui.js";
  listApproved({ limit: 3 })
    .then((themes) => {
      if (!themes.length) return;
      document.getElementById("theme-shelf").replaceChildren(
        ...themes.map((t) =>
          h("li", {}, h("a", { href: link(`/themes/view/?id=${encodeURIComponent(t.id)}`) },
            h("span", { class: "thumb" }, preview(t)),
            h("span", { class: "txt" }, h("strong", {}, t.name), h("span", {}, `by ${t.ownerName || "someone"}`))))
        )
      );
    })
    .catch(() => {});
</script>
