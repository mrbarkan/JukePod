---
// The shop's mark: a orange slice that is also a click wheel.
const { size = 34 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="15.5" fill="var(--accent-deep)" />
  <circle cx="16" cy="16" r="13.6" fill="var(--pith)" />
  <circle cx="16" cy="16" r="12" fill="var(--accent)" />
  <g stroke="var(--pith)" stroke-width="1.3" stroke-linecap="round">
    <path d="M16 4.6v22.8M4.6 16h22.8M7.94 7.94l16.12 16.12M24.06 7.94 7.94 24.06" />
  </g>
  <circle cx="16" cy="16" r="4.6" fill="var(--pith)" />
</svg>
