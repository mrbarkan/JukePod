---
import "../styles/site.css";
import Mark from "../components/Mark.astro";
import { SITE, href, absolute, fmtDate, updatedOn } from "../lib/catalog.js";
import { providers } from "../lib/firebase-config.js";
import { ADS, adsOn } from "../lib/ads.js";

const PROVIDER_NAMES = { google: "Google", github: "GitHub" };

const { title, description = SITE.description, image = "/og.png", type = "website", section = "" } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const nav = [
  { id: "firmware", label: "Firmware", path: "/" },
  { id: "apps", label: "Apps", path: "/apps/" },
  { id: "themes", label: "Themes", path: "/themes/" },
  { id: "mods", label: "Mods", path: "/mods/" },
  { id: "guides", label: "Guides", path: "/start/" },
  { id: "blog", label: "Blog", path: "/blog/" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href={href("/rss.xml")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} new releases`} href={href("/releases.xml")} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || `${SITE.name}: ${SITE.tagline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Schibsted+Grotesk:wght@600;800;900&family=Silkscreen&display=swap"
    />
    {adsOn && (
      <>
        <meta name="google-adsense-account" content={ADS.client} />
        <script async is:inline src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`} crossorigin="anonymous"></script>
      </>
    )}
  </head>
  <body>
    <header class="site-head">
      <div class="wrap head-inner">
        <a class="brand" href={href("/")} aria-label={`${SITE.name} (beta) home`}>
          <Mark />
          <span class="brand-name">{SITE.name}</span>
          <span class="brand-tag">Beta</span>
        </a>
        <nav class="head-nav" aria-label="Sections">
          {nav.map((n) => (
            <a href={href(n.path)} aria-current={section === n.id ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="head-tools">
          <form class="head-search" action={href("/")} method="get" role="search">
            <label class="sr-text" for="site-q">Search the shop</label>
            <input id="site-q" name="q" type="search" placeholder="Search the shop" autocomplete="off" />
          </form>
          <div class="account" id="account">
            <button type="button" class="account-btn" data-signed-out data-open>Sign in</button>
            <a class="account-btn account-me" href={href("/account/")} data-signed-in hidden>
              <img alt="" width="30" height="30" referrerpolicy="no-referrer" hidden />
              <span data-name>Account</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <dialog class="signin" id="signin-dialog" aria-labelledby="signin-title">
      <button type="button" class="signin-close" data-close aria-label="Close">×</button>
      <h2 id="signin-title">Sign in to Quitanda</h2>
      <p>Signing in lets you share themes and tell others what works on your iPod. Browsing and downloading never need an account.</p>
      <div class="signin-buttons">
        {providers.map((p) => (
          <button type="button" class="btn" data-provider={p}>Continue with {PROVIDER_NAMES[p] || p}</button>
        ))}
      </div>
      <p class="signin-error" data-error role="alert" hidden></p>
      <p class="signin-note">We store your display name and profile picture, and show them next to what you share. <a href={href("/privacy/")}>Privacy policy</a></p>
    </dialog>

    <slot />

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p>Back up your music before you install anything or open your iPod. Everything listed here is made by independent developers and makers, and used at your own risk.</p>
        <p>
          Not affiliated with Apple Inc. iPod is a trademark of Apple Inc. Catalog updated <time datetime={updatedOn}>{fmtDate(updatedOn, true)}</time>.
        </p>
        <p class="foot-links">
          <a href={href("/about/")}>About</a>
          <a href={href("/start/")}>Start here</a>
          <a href={href("/compatibility/")}>Compatibility</a>
          <a href={href("/releases/")}>What's new</a>
          <a href={href("/blog/")}>Blog</a>
          <a href={href("/suggest/")}>Suggest a listing</a>
          <a href={href("/contributors/")}>Contributors</a>
          <a href={href("/rss.xml")}>Blog feed</a>
          <a href={href("/privacy/")}>Privacy</a>
          <a href={href("/gdpr/")}>Your data rights</a>
          <a href={SITE.repo}>Source on GitHub</a>
          {adsOn && <button type="button" class="foot-link" id="ad-privacy">Privacy and cookie settings</button>}
        </p>
      </div>
    </footer>
    <script>
      import "../scripts/account.js";
    </script>
    {adsOn && (
      <script is:inline>
        // Reopens Google's consent message so visitors can change their ad choices.
        document.getElementById("ad-privacy").addEventListener("click", function () {
          window.googlefc = window.googlefc || {};
          googlefc.callbackQueue = googlefc.callbackQueue || [];
          googlefc.callbackQueue.push({ CONSENT_DATA_READY: function () { googlefc.showRevocationMessage(); } });
        });
      </script>
    )}
  </body>
</html>
